{
  "name": "mini-coding-agent",
  "productName": "mini-coding-agent",
  "version": "0.2.1",
  "description": "mini-coding-agent (MCA) - Desktop coding agent built with Electron, React, TypeScript, and shadcn/ui",
  "main": "./out/main/index.js",
  "bin": {
    "mca": "./out/cli/index.js"
  },
  "author": "MCA",
  "engines": {
    "node": ">=26.13.1"
  },
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build && npm run build:cli",
    "build:cli": "esbuild src/cli/index.ts --bundle --platform=node --target=node26 --format=cjs --packages=external --banner:js=\"#!/usr/bin/env node\" --outfile=out/cli/index.js",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:win": "npm run build && electron-builder --win --publish never",
    "package:mac": "npm run build && electron-builder --mac --publish never",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@vscode/ripgrep": "^1.18.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "diff": "^9.0.0",
    "lucide-react": "^0.511.0",
    "picomatch": "^4.0.7",
    "radix-ui": "^1.8.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.7",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.6.6",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^3.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.7",
    "tw-animate-css": "^1.3.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.2"
  }
}
